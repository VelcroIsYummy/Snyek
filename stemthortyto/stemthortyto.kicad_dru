(version 1)
(rule ddrdq
	(condition "A.hasNetclass('DQ')")
	(constraint length (min 147ps) (opt 157ps) (max 167ps))
)
(rule addrcmd
	(condition "A.hasNetclass('ADDR')")
	(constraint length (min 129ps) (opt 149ps) (max 169ps))
)
(rule eMMC
	(condition "A.hasNetclass('eMMC')")
	(constraint length (min 120ps) (opt 130ps) (max 140ps))
)
